{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/package-lock.json"
  ],
  "lsp": {
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": ["package.json"],
              "url": "https://www.schemastore.org/package"
            }
          ]
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["vtsls", "!deno"],
      "formatter": "language_server"
    },
    "TypeScript": {
      "language_servers": ["vtsls", "!deno"],
      "formatter": "language_server"
    },
    "TSX": {
      "language_servers": ["vtsls", "!deno"],
      "formatter": "language_server"
    }
  }
}
